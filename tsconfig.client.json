{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/app/**/*.tsx",
    "src/sr-document-foundation/ui/**/*",
    "src/shared/**/*"
  ]
}

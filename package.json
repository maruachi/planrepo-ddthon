{
  "name": "planrepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "start": "node dist/server/main.js",
    "dev": "tsx scripts/start-dev.ts",
    "test:e2e": "playwright test",
    "test:perf": "tsx scripts/test-performance.ts",
    "verify:claude": "node scripts/verify-claude.mjs",
    "test:acceptance": "tsx scripts/report-acceptance.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
